  /// DeleteSecretRequest names a secret.
  record delete-secret-request {
    name: string,
  }

  /// DeleteSecretResponse says whether there was one.
  record delete-secret-response {
    found: bool,
  }

  /// ListSecretsResponse is the names, sorted.
  record list-secrets-response {
    names: list<string>,
  }

  /// PatchLayoutRequest is the operations, as patch_layout's JSON.
  record patch-layout-request {
    /// ops is the JSON array of operations patch_layout takes: insert,
    /// remove, move, resize, select, by node id.
    ops: string,
    /// document is the document's name; "" is default.
    document: string,
    /// if_rev is the revision the ops were made against, "" for none: the
    /// change is refused if the document changed since.
    if-rev: string,
  }

  /// PatchLayoutResponse says the change was taken.
  record patch-layout-response {
    /// revision is always "": the document's revision after comes with the
    /// event that tells the outcome.
    revision: string,
    /// request_id names the change in that event.
    request-id: string,
    /// asked says the user is asked to allow it.
    asked: bool,
  }

  /// RunProcessRequest is a program and its arguments.
  record run-process-request {
    argv: list<string>,
  }

  /// RunProcessResponse is what it printed and how it ended.
  record run-process-response {
    output: string,
    exit-code: s32,
  }

  /// StatusResponse tells whether a decision model is available.
  record status-response {
    /// available says a provider has a key; provider and model are what an
    /// evaluation would use now ("" when not available).
    available: bool,
    provider: string,
    model: string,
  }

  /// EvaluateRequest asks the decision model typed questions synchronously.
  record evaluate-request {
    /// request_json is a decision request: {"state": any, "questions": {key:
    /// {"type": "choice"|"score"|"noul", "instructions", "options"|"levels"|
    /// "criteria"}}}, or one question's fields at the top. At most 256 KiB
    /// and 32 questions.
    request-json: string,
    /// timeout_ms bounds it: 0 for 15 s, at most 20000.
    timeout-ms: u32,
  }

  /// EvaluateResponse holds the normalized decision answers.
  record evaluate-response {
    /// response_json is the normalized response: {"provider","model",
    /// "answers": {key: {"type","choice","score","level","label","probability",
    /// "yes","confidence","probabilities","refusal"}}, and the sole answer's
    /// fields at the top for one question}.
    response-json: string,
    provider: string,
    model: string,
    elapsed-ms: u32,
  }

  /// SubmitRequest asks the decision model typed questions asynchronously.
  record submit-request {
    request-json: string,
    /// timeout_ms: 0 for 30 s, at most 45000.
    timeout-ms: u32,
    /// tag is the plugin's own, at most 512 bytes, given back in the event.
    tag: string,
  }

  /// SubmitResponse identifies the pending asynchronous decision evaluation.
  record submit-response {
    request-id: string,
  }

  /// ListAgentsResponse lists the node's agents and profiles.
  record list-agents-response {
    agents: list<agent-profile>,
  }

  /// AgentProfile is an agent's configuration, its default ("" profile) or one
  /// of its profiles.
  record agent-profile {
    agent: string,
    profile: string,
    /// label is "agent" or "agent · profile".
    label: string,
    description: string,
    model: string,
    effort: string,
    /// installed says its program is found; askable that it may be asked now;
    /// reason why not, when it may not.
    installed: bool,
    askable: bool,
    reason: string,
    /// always_allowed says the user lets the plugin ask it without asking.
    always-allowed: bool,
  }

  /// AskAgentRequest asks an agent a one-shot question in a project folder.
  record ask-agent-request {
    agent: string,
    profile: string,
    /// project is a project's ID and root one of its folders ("" for its
    /// first), as the block's context gives them: where the agent runs.
    project: string,
    root: string,
    /// prompt is the question with its context, at most 96 KiB.
    prompt: string,
    /// format is "text" (default) or "json"; json_schema, at most 16 KiB, the
    /// JSON Schema a json answer follows, where the agent takes one.
    format: string,
    json-schema: string,
    /// timeout_ms bounds the run: 0 for 120 s, from 15000 to 300000.
    timeout-ms: u32,
    /// title is what the user is shown when asked, at most 200 bytes.
    title: string,
    /// tag is the plugin's own, at most 512 bytes, given back in the event.
    tag: string,
  }

  /// AskAgentResponse says the ask was accepted.
  record ask-agent-response {
    request-id: string,
    /// asked says the user is asked first; else it runs at once.
    asked: bool,
  }

  /// CancelAskRequest names an ask to cancel.
  record cancel-ask-request {
    request-id: string,
  }

  /// CancelAskResponse says whether the ask was found and canceled.
  record cancel-ask-response {
    found: bool,
  }
}

/// GitService reads and changes git work trees this node knows: a folder of a
/// project location, a session's folder or worktree on any node of the mesh,
/// or the folder of a folder-scoped block of this plugin's that a window shows.
/// Reads: 120/min. Runs: 30/min, only in answer to the user (an event or
/// command), carried out after the call returns; the outcome comes to the
/// default export's on.gitDone. Watches: 16 at a time, bound to the calling
/// block instance.
interface git {
  use types.{git-service-status-request, git-service-status-response, git-service-history-request, git-service-history-response, git-service-show-commit-request, git-service-show-commit-response, git-service-watch-request, git-service-watch-response, git-service-unwatch-request, git-service-run-request, git-service-run-response};

  /// Status reads the working tree changes, branches, stashes, and operation
  /// state of a repository.
  /// Needs the permission git:read.
  status: func(req: git-service-status-request) -> result<git-service-status-response, string>;

  /// History lists recent commits of a repository, skipping the commit list
  /// when the repository fingerprint matches known.
  /// Needs the permission git:read.
  history: func(req: git-service-history-request) -> result<git-service-history-response, string>;

  /// ShowCommit reads one commit's metadata and changed files.
  /// Needs the permission git:read.
  show-commit: func(req: git-service-show-commit-request) -> result<git-service-show-commit-response, string>;

  /// Watch subscribes the calling block instance to reloads whenever the
  /// target repository changes.
  /// Needs the permission git:read.
  watch: func(req: git-service-watch-request) -> result<git-service-watch-response, string>;

  /// Unwatch stops watching the target repository for the calling block
  /// instance.
  /// Needs the permission git:read.
  unwatch: func(req: git-service-unwatch-request) -> result<_, string>;

  /// Run executes a mutating git operation asynchronously in answer to a user
  /// gesture; the outcome arrives at on.gitDone.
  /// Needs the permission git:write.
  run: func(req: git-service-run-request) -> result<git-service-run-response, string>;
}

/// ForgeService reads pull request and CI status for a repository's branch.
/// Rate limit: 30/min.
interface forge {
  use types.{forge-service-branch-status-request, forge-service-branch-status-response};

  /// BranchStatus returns the pull request and CI runs of a branch, as the
  /// Git panel's forge line shows them.
  /// Needs the permission forge:read.
  branch-status: func(req: forge-service-branch-status-request) -> result<forge-service-branch-status-response, string>;
}

/// LogService writes to the daemon's log, under the plugin's name.
interface log {
  use types.{write-request};

  /// Write puts a line in the daemon's log.
  write: func(req: write-request) -> result<_, string>;
}

/// SettingsService reads the plugin's own settings, which its manifest
/// declares and the user sets in Settings ▸ Plugins.
interface settings {
  use types.{get-setting-request, get-setting-response, list-settings-request, list-settings-response};

  /// GetSetting reads one setting.
  get-setting: func(req: get-setting-request) -> result<get-setting-response, string>;

  /// ListSettings reads every setting the manifest declares.
  list-settings: func(req: list-settings-request) -> result<list-settings-response, string>;
}

/// StorageService is the plugin's own store of keys and values, on this
/// node, within a quota.
interface storage {
  use types.{get-item-request, get-item-response, set-item-request, set-item-response, delete-item-request, delete-item-response, list-keys-request, list-keys-response};

  /// GetItem reads the value of a key.
  /// Needs the permission storage.
  get-item: func(req: get-item-request) -> result<get-item-response, string>;

  /// SetItem writes the value of a key, unless it would take the store
  /// over its quota.
  /// Needs the permission storage.
  set-item: func(req: set-item-request) -> result<set-item-response, string>;

  /// DeleteItem removes a key.
  /// Needs the permission storage.
  delete-item: func(req: delete-item-request) -> result<delete-item-response, string>;

  /// ListKeys lists the keys that start with a prefix, in order.
  /// Needs the permission storage.
  list-keys: func(req: list-keys-request) -> result<list-keys-response, string>;
}

/// SessionsService reads this node's sessions.
interface sessions {
  use types.{list-sessions-response, get-session-request, get-session-response, read-transcript-request, read-transcript-response, subscribe-request, subscribe-response, unsubscribe-request, unsubscribe-response};

  /// ListSessions lists the node's sessions.
  /// Needs the permission sessions:read.
  list-sessions: func() -> result<list-sessions-response, string>;

  /// GetSession reads one session.
  /// Needs the permission sessions:read.
  get-session: func(req: get-session-request) -> result<get-session-response, string>;

  /// ReadTranscript reads a page of a session's conversation, as its agent
  /// logged it: the latest messages, or those before a cursor an earlier
  /// page gave. A session of this node's alone, at most 30 pages a minute.
  /// Needs the permission sessions:read.
  read-transcript: func(req: read-transcript-request) -> result<read-transcript-response, string>;

  /// Subscribe has the plugin told of the events of the kinds named, as
  /// calls of its default export's on handlers (see SessionEvent): the
  /// daemon starts the plugin for one when it is not running. What a
  /// plugin subscribed to stays, kept on this node, until it unsubscribes,
  /// or is removed.
  /// Needs the permission sessions:read.
  subscribe: func(req: subscribe-request) -> result<subscribe-response, string>;

  /// Unsubscribe stops the events of the kinds named; none named stops
  /// every one.
  /// Needs the permission sessions:read.
  unsubscribe: func(req: unsubscribe-request) -> result<unsubscribe-response, string>;
}

/// MeshService exposes the node's P2P mesh topology and sessions across this
/// node and reachable trusted peers.
interface mesh {
  use types.{list-nodes-response, mesh-service-list-sessions-response};

  /// ListNodes lists this node and known mesh peers.
  /// Needs the permission sessions:read.
  list-nodes: func() -> result<list-nodes-response, string>;

  /// ListSessions lists sessions across this node and reachable trusted peers.
  /// Needs the permission sessions:read.
  list-sessions: func() -> result<mesh-service-list-sessions-response, string>;
}

/// HttpService makes HTTP requests for the plugin, to the hosts its
/// manifest names as net:<host> and the user allowed: by https, on the
/// default port, following redirects only within the host. Each request
/// is logged under the plugin's name.
interface http {
  use types.{fetch-request, fetch-response};

  /// Fetch makes a request and reads the response.
  /// Needs the permission net.
  fetch: func(req: fetch-request) -> result<fetch-response, string>;
}

/// CommandsService runs the window's commands a plugin may use.
interface commands {
  use types.{run-command-request};

  /// RunCommand runs a command of the window's: "mako.openUrl", with the
  /// URL as its argument, opens an http or https link in the browser, and
  /// only in answer to the user's tap or command.
  run-command: func(req: run-command-request) -> result<_, string>;
}

/// DbService gives a plugin sandboxed SQLite databases (per scope) and optional
/// CRDT-replicated synced tables shared across paired Mako nodes over the
/// daemon's libp2p mesh.
interface db {
  use types.{query-request, query-response, exec-request, exec-response, batch-request, batch-response, stats-request, stats-response, sync-enable-request, sync-enable-response, sync-put-request, sync-put-response, sync-delete-request, sync-delete-response};

  /// Query runs a single read-only SQL statement (SELECT / WITH / EXPLAIN).
  /// Needs the permission db.
  query: func(req: query-request) -> result<query-response, string>;

  /// Exec runs a single DML or DDL SQL statement.
  /// Needs the permission db.
  exec: func(req: exec-request) -> result<exec-response, string>;

  /// Batch runs up to 64 DML/DDL statements atomically in one transaction.
  /// Needs the permission db.
  batch: func(req: batch-request) -> result<batch-response, string>;

  /// Stats returns the plugin's total SQLite database usage, quota, and
  /// registered synced tables in the requested scope.
  /// Needs the permission db.
  stats: func(req: stats-request) -> result<stats-response, string>;

  /// SyncEnable registers a row-level CRDT synced table backed by SQLite
  /// columns (id, doc, updated_at, deleted) replicated across paired peers.
  /// Needs the permission db:sync.
  sync-enable: func(req: sync-enable-request) -> result<sync-enable-response, string>;

  /// SyncPut stamps a JSON row with the node's HLC clock, writes it to the
  /// synced SQLite table, and schedules P2P replication to trusted peers.
  /// Needs the permission db:sync.
  sync-put: func(req: sync-put-request) -> result<sync-put-response, string>;

  /// SyncDelete marks a synced row as deleted (tombstone) with the node's HLC
  /// clock and schedules P2P replication to trusted peers.
  /// Needs the permission db:sync.
  sync-delete: func(req: sync-delete-request) -> result<sync-delete-response, string>;
}

/// DatafsService gives a plugin its own sandboxed, per-scope directory tree
/// under plugin-data/<id>/files/ for storing and managing files and folders
/// within a quota.
interface datafs {
  use types.{read-data-request, read-data-response, write-data-request, write-data-response, list-data-request, list-data-response, stat-data-request, stat-data-response, mkdir-data-request, delete-data-request, delete-data-response, move-data-request, data-stats-request, data-stats-response};

  /// ReadData reads a regular file from the plugin's private data directory.
  /// Needs the permission fs:data.
  read-data: func(req: read-data-request) -> result<read-data-response, string>;

  /// WriteData writes a regular file whole, atomically, inside the plugin's
  /// private data directory.
  /// Needs the permission fs:data.
  write-data: func(req: write-data-request) -> result<write-data-response, string>;

  /// ListData lists entries in a directory (optionally recursively) inside the
  /// plugin's private data directory.
  /// Needs the permission fs:data.
  list-data: func(req: list-data-request) -> result<list-data-response, string>;

  /// StatData returns metadata for a file or directory inside the plugin's
  /// private data directory.
  /// Needs the permission fs:data.
  stat-data: func(req: stat-data-request) -> result<stat-data-response, string>;

  /// MkdirData creates a directory (and any missing parents) inside the
  /// plugin's private data directory.
  /// Needs the permission fs:data.
  mkdir-data: func(req: mkdir-data-request) -> result<_, string>;

  /// DeleteData removes a file or directory inside the plugin's private data
  /// directory.
  /// Needs the permission fs:data.
  delete-data: func(req: delete-data-request) -> result<delete-data-response, string>;

  /// MoveData renames or moves a file or directory within the same scope of the
  /// plugin's private data directory.
  /// Needs the permission fs:data.
  move-data: func(req: move-data-request) -> result<_, string>;

  /// DataStats returns total bytes used across the plugin's private data
  /// directory, its quota, and file count.
  /// Needs the permission fs:data.
  data-stats: func(req: data-stats-request) -> result<data-stats-response, string>;
}

/// MessagesService acts on this node's sessions: sends their agents
/// messages, starts agents and stops those the plugin started. A message
/// is headed as the plugin's, so that the agent cannot take it for the
/// user's or mako's. Starting an agent runs a program that costs money:
/// the user is asked the first time, and may allow the plugin from then
/// on; the start is carried out after the call returns, and its outcome
/// comes to the default export's on.agentStarted or on.agentRefused, as a
/// SessionEvent with the request's id.
interface messages {
  use types.{send-message-request, send-message-response, start-agent-request, start-agent-response, stop-agent-request};

  /// SendMessage leaves a message for a session's agent, typed into its
  /// terminal once it waits at its prompt, as send_message does: a session
  /// of this node's whose agent takes messages. 30 a minute.
  /// Needs the permission sessions:write.
  send-message: func(req: send-message-request) -> result<send-message-response, string>;

  /// StartAgent asks to start an agent with a prompt in a folder of a
  /// project this node knows (FilesService.ListProjects). At most 3 of a
  /// plugin's run at once, and it starts 10 an hour.
  /// Needs the permission sessions:write.
  start-agent: func(req: start-agent-request) -> result<start-agent-response, string>;

  /// StopAgent stops a session the plugin started.
  /// Needs the permission sessions:write.
  stop-agent: func(req: stop-agent-request) -> result<_, string>;
}

/// FilesService reads the files of the projects this node knows, and
/// with fs:project:write writes them. A project is named by its ID and one
/// of its folders by its path, as ListProjects gives them, and a file by
/// its path in that folder: relative, without "..". Nothing outside a
/// project's folders is reached, by a path or through a symbolic link;
/// nothing but regular files is read or written; a write replaces the file
/// whole, atomically, and never under a folder named .git. A plugin reads
/// 120 times a minute and writes 30, at most 1 MiB a call.
interface files {
  use types.{read-file-request, read-file-response, list-projects-response, list-dir-request, list-dir-response, write-file-request, write-file-response};

  /// ReadFile reads a file of a project's folder, or a piece of it.
  /// Needs the permission fs:project.
  read-file: func(req: read-file-request) -> result<read-file-response, string>;

  /// ListProjects lists the projects this node knows, and their folders
  /// on it.
  /// Needs the permission fs:project.
  list-projects: func() -> result<list-projects-response, string>;

  /// ListDir lists a folder of a project's folder.
  /// Needs the permission fs:project.
  list-dir: func(req: list-dir-request) -> result<list-dir-response, string>;

  /// WriteFile writes a file of a project's folder whole, in place of what
  /// was there.
  /// Needs the permission fs:project:write.
  write-file: func(req: write-file-request) -> result<write-file-response, string>;
}

/// SecretsService keeps the plugin's own secrets in the system's keychain
/// (the macOS Keychain, the Secret Service, Windows' Credential Manager),
/// on this node alone: never synced, never logged, removed with the
/// plugin. A node whose system has none keeps them in a file only the user
/// may read, and says so to the user. A plugin keeps at most 32, and calls
/// the group at most 60 times a minute.
interface secrets {
  use types.{get-secret-request, get-secret-response, set-secret-request, delete-secret-request, delete-secret-response, list-secrets-response};

  /// GetSecret reads a secret.
  /// Needs the permission secrets.
  get-secret: func(req: get-secret-request) -> result<get-secret-response, string>;

  /// SetSecret keeps a secret, replacing one of its name.
  /// Needs the permission secrets.
  set-secret: func(req: set-secret-request) -> result<_, string>;

  /// DeleteSecret removes a secret.
  /// Needs the permission secrets.
  delete-secret: func(req: delete-secret-request) -> result<delete-secret-response, string>;

  /// ListSecrets lists the names of the secrets kept, not their values.
  /// Needs the permission secrets.
  list-secrets: func() -> result<list-secrets-response, string>;
}

/// LayoutService changes the window's layout, as the user allows, through
/// the very flow an agent's patch_layout takes: the change is staged on
/// this node and shown, the user is asked unless they allowed this
/// plugin such changes before (for the document, or every one), and only
/// then is it written into the workspace the user's nodes share. The
/// window names the plugin as the change's origin. A plugin changes a
/// document's root alone, never its variants. The answer may take
/// minutes, so the call returns at once; the outcome comes to the default
/// export's on.layoutChanged or on.layoutRefused, as a SessionEvent with
/// the request's id.
interface layout {
  use types.{patch-layout-request, patch-layout-response};

  /// PatchLayout changes a window layout document by node id, as
  /// patch_layout does. 10 a minute, one waiting at a time.
  /// Needs the permission layout:write.
  patch-layout: func(req: patch-layout-request) -> result<patch-layout-response, string>;
}

/// ExecService runs programs. No plugin is granted exec in this version:
/// a manifest that asks for it is refused.
interface exec {
  use types.{run-process-request, run-process-response};

  /// RunProcess runs a program.
  /// Needs the permission exec.
  run-process: func(req: run-process-request) -> result<run-process-response, string>;
}

/// DecisionService asks this node's decision model typed questions (choice,
/// score, noul) about a state, as mako.decide does in a prompt template, with
/// the provider, model and API keys the user set in Settings ▸ API keys: a
/// request's own provider and model are ignored. No key is ever told. The
/// plugin evaluates 60 times a minute, Evaluate and Submit together.
interface decision {
  use types.{status-response, evaluate-request, evaluate-response, submit-request, submit-response};

  /// Status says whether a decision model is set up, and which.
  /// Needs the permission decision.
  status: func() -> result<status-response, string>;

  /// Evaluate evaluates a request and waits for its answers, at most 20 s.
  /// Needs the permission decision.
  evaluate: func(req: evaluate-request) -> result<evaluate-response, string>;

  /// Submit evaluates a request after the call returns, at most 45 s; its
  /// answers come to the default export's on.decisionAnswered, or why not
  /// to on.decisionFailed, as a SessionEvent with the request's id and tag.
  /// At most 2 of a plugin's wait at once.
  /// Needs the permission decision.
  submit: func(req: submit-request) -> result<submit-response, string>;
}

/// AgentsService lists the agents of this node a plugin may ask, and asks
/// one a question: the agent runs once, not interactively, without YOLO, in
/// a folder of a project of this node's, and its answer comes back to the
/// plugin. The first ask of an agent and profile is asked of the user, who
/// may allow that one alone or every ask of that agent and profile from then
/// on. At most 2 of a plugin's asks wait or run at once, and it asks 30 times
/// an hour.
interface agents {
  use types.{list-agents-response, ask-agent-request, ask-agent-response, cancel-ask-request, cancel-ask-response};

  /// ListAgents lists this node's agents and their profiles, and whether
  /// each may be asked.
  /// Needs the permission agents:ask.
  list-agents: func() -> result<list-agents-response, string>;

  /// AskAgent asks an agent a question after the call returns; its answer
  /// comes to the default export's on.agentAnswered, or why none to
  /// on.agentAskFailed, as a SessionEvent with the request's id and tag.
  /// Needs the permission agents:ask.
  ask-agent: func(req: ask-agent-request) -> result<ask-agent-response, string>;

  /// CancelAsk cancels an ask of the plugin's that waits or runs.
  /// Needs the permission agents:ask.
  cancel-ask: func(req: cancel-ask-request) -> result<cancel-ask-response, string>;
}

/// What a plugin's component imports: the whole Host API. The host
/// refuses at run time the calls the plugin has no permission for.
world plugin {
  import git;
  import forge;
  import log;
  import settings;
  import storage;
  import sessions;
  import mesh;
  import http;
  import commands;
  import db;
  import datafs;
  import messages;
  import files;
  import secrets;
  import layout;
  import exec;
  import decision;
  import agents;
}
